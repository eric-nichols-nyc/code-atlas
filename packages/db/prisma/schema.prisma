generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String             @id @default(cuid())
  neonUserId String             @unique @db.VarChar(160)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  progress    PracticeProgress[]
  notes       ProblemNote[]
}

model ProblemNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @db.VarChar(160)
  content   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, problemId])
}

model PracticeProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String    @db.VarChar(160)
  flagged         Boolean   @default(false)
  solvedAt        DateTime? @db.Timestamptz(3)
  legacyCompleted Boolean   @default(false)
  lastCode        String?
  codeUpdatedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, problemId])
}
