{
  "name": "@workspace/desktop",
  "productName": "Code Atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "Code Atlas desktop client",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "package:local": "pnpm build && node scripts/package.mjs --local",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.10.0",
    "electron": "45.3.2",
    "typescript": "5.9.3"
  }
}
